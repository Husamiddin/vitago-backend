# Google Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Asosiy multimodal model (tezkor va yuqori kvotali retsept o'qish modeli)
GEMINI_MODEL=gemini-3.5-flash-lite

# Ma'lumotlar bazasi (MVP uchun SQLite, ishlab chiqarish uchun PostgreSQL URL)
DATABASE_URL=sqlite:///./doriscan.db

# Ruxsat etilgan frontend manzillari
CORS_ORIGINS=*

# Telegram Bot va Mini App sozlamalari (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=DoriScan_bot
PUBLIC_WEB_URL=https://doriscan.vercel.app
MINI_APP_URL=https://doriscan.vercel.app/?tg=1
